#!/usr/bin/python3
"""Root-owned launcher used only through the constrained sudoers rule."""

from __future__ import annotations

import grp
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

CODEX_BINARY = Path("/usr/local/libexec/pitbench-codex-bin")
CODE_MODE_HOST = Path("/usr/local/libexec/codex-code-mode-host")
PROXY_KEYS = {
    "ALL_PROXY",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "all_proxy",
    "http_proxy",
    "https_proxy",
    "no_proxy",
}


def _self_test() -> int:
    group_names = sorted(grp.getgrgid(group_id).gr_name for group_id in os.getgroups())
    docker_socket_access = os.access("/var/run/docker.sock", os.R_OK | os.W_OK)
    print(
        json.dumps(
            {
                "uid": os.getuid(),
                "groups": group_names,
                "docker_socket_access": docker_socket_access,
            },
            sort_keys=True,
        )
    )
    return int(docker_socket_access or "docker" in group_names)


def _run_codex(arguments: list[str]) -> int:
    if not CODEX_BINARY.is_file() or not os.access(CODEX_BINARY, os.X_OK):
        raise RuntimeError(f"Installed Codex binary is unavailable: {CODEX_BINARY}")
    if not CODE_MODE_HOST.is_file() or not os.access(CODE_MODE_HOST, os.X_OK):
        raise RuntimeError(
            f"Installed Codex code-mode host is unavailable: {CODE_MODE_HOST}"
        )
    payload = json.load(sys.stdin)
    auth_json = payload.get("auth_json")
    if not isinstance(auth_json, str) or not auth_json.strip():
        raise ValueError("auth_json must be a non-empty string")
    json.loads(auth_json)
    requested_proxy_env = payload.get("proxy_env") or {}
    if not isinstance(requested_proxy_env, dict):
        raise ValueError("proxy_env must be an object")
    proxy_env = {
        key: str(value)
        for key, value in requested_proxy_env.items()
        if key in PROXY_KEYS and value
    }

    with tempfile.TemporaryDirectory(prefix="pitbench-codex-runner-") as root_str:
        root = Path(root_str)
        codex_home = root / "codex-home"
        workspace = root / "workspace"
        codex_home.mkdir(mode=0o700)
        workspace.mkdir(mode=0o700)
        auth_path = codex_home / "auth.json"
        auth_path.write_text(auth_json)
        auth_path.chmod(0o600)
        env = os.environ.copy()
        env.update(proxy_env)
        env.pop("OPENAI_API_KEY", None)
        env["CODEX_HOME"] = str(codex_home)
        env["HOME"] = str(root)
        result = subprocess.run(
            [
                str(CODEX_BINARY),
                "--ask-for-approval",
                "never",
                *arguments,
            ],
            cwd=workspace,
            env=env,
            stdin=subprocess.DEVNULL,
            check=False,
        )
        return result.returncode


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        return _self_test()
    if not sys.argv[1:] or sys.argv[1] != "exec":
        raise ValueError("runner only accepts Codex exec arguments")
    return _run_codex(sys.argv[1:])


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"pitbench-codex-runner: {error}", file=sys.stderr)
        raise SystemExit(2)
